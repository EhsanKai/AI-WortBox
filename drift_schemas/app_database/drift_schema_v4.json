  "fixed_sql": [
    {
      "name": "decks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"decks\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"source_language\" TEXT NOT NULL, \"definition_language\" TEXT NOT NULL, \"daily_new_card_limit\" INTEGER NOT NULL CHECK(\"daily_new_card_limit\" BETWEEN 0 AND 1000), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "vocabulary_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vocabulary_entries\" (\"id\" TEXT NOT NULL, \"deck_id\" TEXT NOT NULL REFERENCES decks (id) ON DELETE CASCADE, \"original\" TEXT NOT NULL, \"normalized\" TEXT NOT NULL, \"lemma\" TEXT NULL, \"source_language\" TEXT NOT NULL, \"definition_language\" TEXT NOT NULL, \"part_of_speech\" TEXT NULL, \"example_sentence\" TEXT NULL, \"example_translation\" TEXT NULL, \"grammar_info\" TEXT NULL, \"notes\" TEXT NULL, \"source_context\" TEXT NULL, \"source_type\" TEXT NOT NULL, \"enrichment_status\" TEXT NOT NULL, \"enrichment_metadata\" TEXT NULL, \"user_edited_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"marked_difficult_at\" TEXT NULL, \"search_key\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "vocabulary_meanings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vocabulary_meanings\" (\"id\" TEXT NOT NULL, \"entry_id\" TEXT NOT NULL REFERENCES vocabulary_entries (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"meaning\" TEXT NOT NULL, \"explanation\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"entry_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "flashcards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"flashcards\" (\"id\" TEXT NOT NULL, \"entry_id\" TEXT NOT NULL REFERENCES vocabulary_entries (id) ON DELETE CASCADE, \"direction\" TEXT NOT NULL, \"state\" TEXT NOT NULL, \"step\" INTEGER NULL, \"stability\" REAL NULL, \"difficulty\" REAL NULL, \"due\" TEXT NOT NULL, \"last_reviewed_at\" TEXT NULL, \"review_count\" INTEGER NOT NULL DEFAULT 0, \"lapse_count\" INTEGER NOT NULL DEFAULT 0, \"scheduler_version\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"entry_id\", \"direction\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"name_key\" TEXT NOT NULL UNIQUE, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "entry_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entry_tags\" (\"entry_id\" TEXT NOT NULL REFERENCES vocabulary_entries (id) ON DELETE CASCADE, \"tag_id\" TEXT NOT NULL REFERENCES tags (id) ON DELETE CASCADE, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"entry_id\", \"tag_id\"));"
        }
      ]
    },
    {
      "name": "review_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_events\" (\"id\" TEXT NOT NULL, \"entry_id\" TEXT NULL REFERENCES vocabulary_entries (id) ON DELETE SET NULL, \"session_id\" TEXT NOT NULL, \"direction\" TEXT NOT NULL, \"outcome\" TEXT NOT NULL, \"reviewed_at\" TEXT NOT NULL, \"local_day\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
